---
import { readFileSync } from 'node:fs';
import { selectReleases, formatSize, fileName, isFixtureManifestPath } from '../lib/firmware.mjs';
// Browser tests build extra copies of the site from fixture manifests (see playwright.config.mjs).
// The override is accepted only for files under tests/fixtures/, so a stray variable cannot change the real page.
const override = process.env.FIRMWARE_MANIFEST;
if (override && !isFixtureManifestPath(override)) throw new Error('FIRMWARE_MANIFEST must be under tests/fixtures/');
const manifest = JSON.parse(readFileSync(override || 'src/data/firmware/can-usb.json', 'utf8'));
const { latest, older } = selectReleases(manifest);
const others = latest?.canimal?.others ?? [];
const labels = { 'macos-arm64': 'macOS, Apple silicon', 'macos-x86_64': 'macOS, Intel', 'windows-x86_64': 'Windows, x64' };
---
{!latest && older.length === 0 && (
  <p><strong>No public release yet; contact support for firmware updates.</strong></p>
)}
{!latest && older.length > 0 && (
  <p><strong>No stable release yet.</strong></p>
)}
{latest && (
  <section class="firmware-latest" aria-labelledby="latest-release">
    <h3 id="latest-release">Latest stable release: {latest.version}</h3>
    <dl>
      <dt>Released</dt><dd>{latest.date}</dd>
      <dt>File</dt><dd><a href={latest.file} download>{fileName(latest.file)}</a></dd>
      <dt>Size</dt><dd>{formatSize(latest.size)}</dd>
      <dt>SHA-256</dt><dd><code>{latest.sha256}</code></dd>
    </dl>
    <p><a href={latest.notes}>Release notes</a></p>
  </section>
)}
{latest?.canimal && (
  <section class="canimal-tool" aria-labelledby="canimal-tool">
    <h3 id="canimal-tool">canimal command-line tool</h3>
    <p>One file, no install, no Python. It finds the CAN-USB, captures, sends and updates firmware. Version {latest.version}.</p>
    <h4>Linux (x86-64)</h4>
    <dl>
      <dt>File</dt><dd><a href={latest.canimal.file} download>{fileName(latest.canimal.file)}</a></dd>
      <dt>Size</dt><dd>{formatSize(latest.canimal.size)}</dd>
      <dt>SHA-256</dt><dd><code>{latest.canimal.sha256}</code></dd>
    </dl>
    <p>Check the download, make it executable and run it:</p>
    <pre><code>sha256sum canimal-linux-x86_64
chmod +x canimal-linux-x86_64
./canimal-linux-x86_64 --help</code></pre>
    {others.map(o => (
      <>
        <h4>{labels[o.platform]}</h4>
        <dl>
          <dt>File</dt><dd><a href={o.file} download>{fileName(o.file)}</a></dd>
          <dt>Size</dt><dd>{formatSize(o.size)}</dd>
          <dt>SHA-256</dt><dd><code>{o.sha256}</code></dd>
        </dl>
        {o.platform.startsWith('macos') && (
          <>
            <p>The macOS files are not signed by Apple yet, so Gatekeeper blocks the first run. Check the download, remove the quarantine flag and run it:</p>
            <pre><code>shasum -a 256 {fileName(o.file)}
chmod +x {fileName(o.file)}
xattr -d com.apple.quarantine {fileName(o.file)}
./{fileName(o.file)} --help</code></pre>
          </>
        )}
        {o.platform.startsWith('windows') && (
          <>
            <p>Check the download in PowerShell, then run it:</p>
            <pre><code>Get-FileHash {fileName(o.file)} -Algorithm SHA256
.\{fileName(o.file)} --help</code></pre>
            <p>Windows needs the WinUSB driver on the CAN-USB before the tool can open it. Install it with <a href="https://zadig.akeo.ie/">Zadig</a> until the device installs without one.</p>
          </>
        )}
      </>
    ))}
  </section>
)}
{older.length > 0 && (
  <>
    <h3 id="other-releases">Other releases</h3>
    <div class="firmware-table">
      <table>
        <thead><tr><th>Version</th><th>Released</th><th>Channel</th><th>File</th><th>Size</th><th>SHA-256</th><th>Notes</th></tr></thead>
        <tbody>
          {older.map(r => (
            <tr>
              <td>{r.version}</td><td>{r.date}</td><td>{r.channel}</td>
              <td><a href={r.file} download>{fileName(r.file)}</a></td>
              <td>{formatSize(r.size)}</td><td><code>{r.sha256}</code></td><td><a href={r.notes}>Release notes</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>
)}
<style>
  .firmware-table { overflow-x: auto; }
  code { overflow-wrap: anywhere; }
  dt { font-weight: 600; }
</style>
